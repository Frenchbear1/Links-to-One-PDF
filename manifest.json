{
  "manifest_version": 3,
  "name": "Links to One PDF",
  "version": "1.0.0",
  "description": "Opens every link on a page in background tabs, saves each as a PDF, and merges them all into one big PDF.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Links to One PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "scripting", "debugger", "downloads", "storage"],
  "host_permissions": ["<all_urls>"]
}
